worker_processes 1;

events { worker_connections 1024; }

http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    # Low-volume personal robot; keep some abuse protection at public edge.
    limit_req_zone $binary_remote_addr zone=ota:10m rate=30r/m;

    server {
        listen 8080;
        server_name _;

        # Hide all unspecified paths.
        location / {
            return 404;
        }

        # Health endpoint contains no secret data.
        location = /healthz {
            add_header Content-Type text/plain;
            return 200 "robot-ai-anywhere-v6.8 ok\n";
        }

        # OTA discovery. Device-Id / Client-Id / Authorization headers are
        # preserved by nginx and passed to XiaoZhi.
        location = /r/__ROBOT_GATEWAY_SECRET__/xiaozhi/ota/ {
            limit_req zone=ota burst=10 nodelay;
            proxy_pass http://xiaozhi-private:8003/xiaozhi/ota/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Device-Id $http_device_id;
            proxy_set_header Client-Id $http_client_id;
            proxy_set_header Device-Model $http_device_model;
            proxy_set_header Device-Version $http_device_version;
            proxy_set_header Authorization $http_authorization;
            proxy_read_timeout 20s;
        }

        # OTA application binary.
        location ^~ /r/__ROBOT_GATEWAY_SECRET__/xiaozhi/ota/download/ {
            limit_req zone=ota burst=10 nodelay;
            rewrite ^/r/__ROBOT_GATEWAY_SECRET__/xiaozhi/ota/download/([A-Za-z0-9._-]+\.bin)$ /xiaozhi/ota/download/$1 break;
            proxy_pass http://xiaozhi-private:8003;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 120s;
        }

        # XiaoZhi bidirectional audio websocket.
        location = /r/__ROBOT_GATEWAY_SECRET__/xiaozhi/v1/ {
            proxy_pass http://xiaozhi-private:8000/xiaozhi/v1/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Protocol-Version $http_protocol_version;
            proxy_set_header Device-Id $http_device_id;
            proxy_set_header Client-Id $http_client_id;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        location = /r/__ROBOT_GATEWAY_SECRET__/xiaozhi/v1 {
            return 308 /r/__ROBOT_GATEWAY_SECRET__/xiaozhi/v1/;
        }

        # Kept for XiaoZhi OTA URL construction / future vision support.
        location = /r/__ROBOT_GATEWAY_SECRET__/mcp/vision/explain {
            proxy_pass http://xiaozhi-private:8003/mcp/vision/explain;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 60s;
        }
    }
}
