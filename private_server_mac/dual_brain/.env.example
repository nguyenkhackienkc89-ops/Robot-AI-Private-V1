# ROBOT AI PRIVATE V6.1 — SMART FREE
# NÃO NHÀ
LOCAL_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_MODEL=tieude:qwen3-8b
LOCAL_THINK=false
LOCAL_KEEP_ALIVE=30m

# NÃO MÂY MIỄN PHÍ THEO CẤU HÌNH XIAOZHI CÔNG KHAI
# Chỉ cần điền API key Zhipu/BigModel.
CLOUD_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CLOUD_MODEL=glm-4-flash
CLOUD_API_KEY=

# Mặc định chặn cloud khác để tránh vô tình dùng model tính phí.
BLOCK_NONFREE_CLOUD=true

# "smart_free": câu hỏi kiến thức ưu tiên GLM miễn phí;
# motor/Mac/dữ liệu nhạy cảm/câu xã giao dùng local.
AUTO_POLICY=smart_free

# 0 = không giới hạn. Đặt 200 để chống lạm dụng/rate-limit.
# Đây KHÔNG phải cam kết nhà cung cấp sẽ miễn phí vĩnh viễn.
CLOUD_DAILY_LIMIT=200

AUTO_COMPLEXITY_THRESHOLD=5
REQUEST_TIMEOUT_SECONDS=90
